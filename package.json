{
  "name": "pika",
  "version": "2.4.0",
  "main": "dist-electron/electron/main.js",
  "description": "Open-source live-translation and meeting assistant. Real-time translation, searchable meeting records and an AI agent that helps during the call \u2014 bring your own LLM key or run fully offline with Ollama.",
  "homepage": "https://github.com/royisme/pikabaka#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royisme/pikabaka.git"
  },
  "bugs": {
    "url": "https://github.com/royisme/pikabaka/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "",
  "keywords": [],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "oxlint src electron test --max-warnings 814",
    "test": "tap --node-arg=--import=tsx --node-arg=--disable-warning=DEP0205 \"test/**/*.test.ts\"",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "build:web:raw": "pnpm run clean && tsc && vite build",
    "build": "pnpm run verify && pnpm run build:web:raw",
    "build:electron:raw": "tsc -p electron/tsconfig.json",
    "build:electron": "pnpm run verify && pnpm run build:electron:raw",
    "build:native:raw": "node scripts/build-native.js",
    "build:native": "pnpm run verify && pnpm run build:native:raw",
    "preview": "vite preview",
    "postinstall": "cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 pnpm rebuild sharp && node scripts/download-models.js && node scripts/ensure-sqlite-vec.js",
    "electron:dev": "pnpm run verify && pnpm run build:electron:raw && cross-env NODE_ENV=development electron .",
    "electron:build": "pnpm run verify && pnpm run build:electron:raw && cross-env NODE_ENV=production electron .",
    "app:dev": "concurrently \"pnpm run dev -- --port 5180 --strictPort\" \"wait-on http://localhost:5180 && pnpm run build:electron:raw && cross-env NODE_ENV=development electron .\"",
    "app:prod": "pnpm run verify && pnpm run build:web:raw && pnpm run build:electron:raw && pnpm run build:native:raw && cross-env NODE_ENV=production electron .",
    "app:build": "pnpm run verify && pnpm run build:web:raw && pnpm run build:electron:raw && pnpm run build:native:raw && node scripts/build-app.js",
    "app:notarize": "node scripts/notarize-only.js",
    "release": "node scripts/release.js",
    "watch": "tsc -p electron/tsconfig.json --watch",
    "start": "pnpm run app:dev",
    "dist": "pnpm run app:build",
    "icons:generate": "node generate_icon.js"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.royisme.pika",
    "productName": "Pika",
    "files": [
      "dist",
      "dist-electron",
      "native-module",
      "node_modules",
      "package.json",
      "!**/native-module/target",
      "!**/native-module/src",
      "!**/native-module/.cargo",
      "!**/node_modules/**/{test,tests,__tests__,__mocks__,example,examples,docs,.github}",
      "!**/node_modules/**/*.{md,ts,map}",
      "!**/node_modules/.package-lock.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "resources/models/",
        "to": "models/"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/pika.icns",
      "identity": "shaoqing zhu (UL5T9WXYJT)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/png/",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "royisme",
      "repo": "pikabaka"
    }
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@napi-rs/cli": "^3.10.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tapjs/mock": "4.4.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/color": "^4.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.15.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.91",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/groq": "^4.0.72",
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/react": "^4.0.160",
    "@anthropic-ai/sdk": "^1.3.0",
    "@bany/curl-to-json": "^1.2.10",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@elevenlabs/client": "^1.32.0",
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@google-cloud/speech": "^8.2.1",
    "@google/genai": "^2.31.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@huggingface/transformers": "4.3.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@tanstack/react-query": "^5.105.0",
    "@tavily/core": "^0.7.14",
    "@types/three": "^0.186.0",
    "ai": "^7.0.156",
    "axios": "^1.21.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "form-data": "^4.0.6",
    "framer-motion": "^14.7.1",
    "groq-sdk": "^1.6.0",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.63.0",
    "mammoth": "^1.13.0",
    "openai": "^7.45.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-window": "^2.5.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "screenshot-desktop": "^1.15.7",
    "sharp": "^0.35.5",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.7.0",
    "tap": "^21.8.0",
    "three": "^0.186.1",
    "tree-kill": "^1.2.2",
    "typebox": "1.4.3",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "^0.1.9"
  }
}
